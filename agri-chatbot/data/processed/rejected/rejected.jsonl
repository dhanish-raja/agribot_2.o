{"object": {"crop": "Poplar", "topic": "irrigation", "subtopic": "irrigation schedule and drainage", "information_type": "recommendation", "growth_stage": "growth period (April to October)", "disease": null, "scientific_name": null, "pest": null, "content": "Irrigate poplar at 7-10-day interval during summers as it requires a lot of water during its growth period from April to October. However, standing water for long period, especially in heavy soils, is harmful for Poplar, therefore proper arrangement for drainage must be ensured during monsoon.", "source": "ICAR/Gov", "organization": "ICAR/Gov", "source_url": "https://icar.gov.in/sites/default/files/2025-10/ICAR-En-Kharif-Agro-Advisories-for-Farmers-2025.pdf", "document_name": "Mango Guide - ICAR-En-Kharif-Agro-Advisories-for-Farmers-2025", "page_number": null, "section": "Page 219", "region": "India", "language": "en"}, "reason": "Invalid crop"}
{"object": {"crop": "Poplar", "topic": "fertilizer", "subtopic": "nitrogen application", "information_type": "recommendation", "growth_stage": null, "disease": null, "scientific_name": null, "pest": null, "content": "Apply urea to plants according to their age: 170 g for 1-year-old, 260 g for 2-year-old, 350 g for 3-year-old, 430 g for 4-year-old, 520 g for N soils.", "source": "ICAR/Gov", "organization": "ICAR/Gov", "source_url": "https://icar.gov.in/sites/default/files/2025-10/ICAR-En-Kharif-Agro-Advisories-for-Farmers-2025.pdf", "document_name": "Mango Guide - ICAR-En-Kharif-Agro-Advisories-for-Farmers-2025", "page_number": null, "section": "Page 219", "region": "India", "language": "en"}, "reason": "Invalid crop"}
{"object": {"crop": "Poplar", "topic": "nutrient deficiency", "subtopic": "zinc deficiency management", "information_type": "recommendation", "growth_stage": null, "disease": "Zinc deficiency", "scientific_name": null, "pest": null, "content": "For management of Zinc deficiency in Poplar, apply 100 g, 200 g and 300g Zinc Sulphate Heptahydrate (21%) OR 60g, 120 g and 180 g Zinc Sulphate Monohydrate (33%) for 1, 3, & 5 year of poplar, respectively, in 1 m diameter during 1 year, 2 m diameter ring around tree during 3 year and 3 m wide strip during 5 year, after harvesting of the Rabi intercrop.", "source": "ICAR/Gov", "organization": "ICAR/Gov", "source_url": "https://icar.gov.in/sites/default/files/2025-10/ICAR-En-Kharif-Agro-Advisories-for-Farmers-2025.pdf", "document_name": "Mango Guide - ICAR-En-Kharif-Agro-Advisories-for-Farmers-2025", "page_number": null, "section": "Page 219", "region": "India", "language": "en"}, "reason": "Invalid crop"}
